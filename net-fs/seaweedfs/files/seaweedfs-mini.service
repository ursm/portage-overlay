[Unit]
Description=SeaweedFS all-in-one development server
Documentation=https://github.com/seaweedfs/seaweedfs/wiki
Wants=network-online.target
After=network-online.target seaweedfs-master.service seaweedfs-volume.service seaweedfs-filer.service seaweedfs-s3.service seaweedfs-server.service
Conflicts=seaweedfs-master.service seaweedfs-volume.service seaweedfs-filer.service seaweedfs-s3.service seaweedfs-server.service

[Service]
User=seaweedfs
Group=seaweedfs
StateDirectory=seaweedfs/mini
StateDirectoryMode=0750
WorkingDirectory=/var/lib/seaweedfs/mini
UMask=0027
# Everything is reachable without credentials until some are created, so stay on loopback.
ExecStart=/usr/bin/weed -logtostderr mini -dir=/var/lib/seaweedfs/mini -ip=127.0.0.1 -ip.bind=127.0.0.1
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
SyslogIdentifier=%N

CapabilityBoundingSet=
LockPersonality=yes
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
